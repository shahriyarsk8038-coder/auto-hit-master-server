<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New User - Auto Hit Master</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #0f172a; color: #f8fafc; font-family: 'Segoe UI', system-ui, sans-serif; }
    .sidebar { background: #1e293b; min-height: 100vh; border-right: 1px solid #334155; }
    .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; }
    .nav-link:hover, .nav-link.active { color: #38bdf8; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8; }
    .card-custom { background: #1e293b; border: 2px solid #38bdf8; border-radius: 12px; max-width: 600px; padding: 25px; }
    .form-control, .form-select { background: #0f172a; border: 1px solid #334155; color: #fff; }
    .form-control:focus, .form-select:focus { background: #0f172a; border-color: #38bdf8; color: #fff; }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3" style="width: 260px;">
      <div class="d-flex align-items-center gap-2 mb-4 px-2">
        <img src="/logo.png" style="width:32px; height:32px; object-fit:contain;">
        <h4 class="fw-bold text-info mb-0">Auto Hit Master</h4>
      </div>
      <div class="nav flex-column">
        <a href="/admin/dashboard" class="nav-link"><i class="bi bi-grid-fill me-2"></i> Dashboard</a>
        <a href="/admin/users" class="nav-link"><i class="bi bi-people-fill me-2"></i> Users & Licenses</a>
        <a href="/admin/users/create" class="nav-link active"><i class="bi bi-person-plus-fill me-2"></i> Add New User</a>
        <a href="/admin/logout" class="nav-link text-danger mt-4"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-4">
      <div class="mb-4">
        <h2 class="fw-bold">Create New Client Account</h2>
        <p class="text-muted small">Generate a User ID & Password bound to 1 PC for your client</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2 mb-4"><%= error %></div>
      <% } %>

      <div class="card-custom">
        <form action="/admin/users/create" method="POST">
          <div class="mb-3">
            <label class="text-info fw-bold fs-6 d-block mb-1">১. ইউজার আইডি (USER ID) *</label>
            <input type="text" name="user_id" class="form-control bg-dark text-white border-info p-2" required placeholder="কাস্টমারের লগইন আইডি দিন (যেমন: client01)">
            <div class="text-warning small mt-1">💡 এই আইডিটি আপনার কাস্টমার এক্সটেনশনে লগইন করার সময় ব্যবহার করবে।</div>
          </div>

          <div class="mb-3">
            <label class="text-info fw-bold fs-6 d-block mb-1">২. পাসওয়ার্ড (PASSWORD) *</label>
            <input type="text" name="password" class="form-control bg-dark text-white border-info p-2" required placeholder="কাস্টমারের পাসওয়ার্ড দিন (যেমন: 123456)">
            <div class="text-warning small mt-1">💡 এই পাসওয়ার্ডটি কাস্টমারকে লগইন করার জন্য দেবেন।</div>
          </div>

          <div class="mb-3">
            <label class="text-info fw-bold fs-6 d-block mb-1">৩. কাস্টমারের নাম (CLIENT FULL NAME)</label>
            <input type="text" name="name" class="form-control bg-dark text-white border-secondary p-2" placeholder="কাস্টমার বা তার দোকানের নাম (যেমন: Rahim Travels)">
            <div class="text-muted small mt-1">💡 আপনার চেনার সুবিধার্থে কাস্টমারের নাম লিখে রাখুন।</div>
          </div>

          <div class="mb-3">
            <label class="text-info fw-bold fs-6 d-block mb-1">৪. মোবাইল নম্বর (PHONE NUMBER)</label>
            <input type="text" name="phone" class="form-control bg-dark text-white border-secondary p-2" placeholder="কাস্টমারের মোবাইল নম্বর (যেমন: 01700000000)">
            <div class="text-muted small mt-1">💡 পরবর্তীতে যোগাযোগের জন্য নম্বর লিখে রাখুন।</div>
          </div>

          <div class="mb-4">
            <label class="text-info fw-bold fs-6 d-block mb-1">৫. মেয়াদের সময়সীমা (PACKAGE DURATION) *</label>
            <select name="duration_days" class="form-select bg-dark text-white border-info p-2" required>
              <option value="7">৭ দিন (১ সপ্তাহ)</option>
              <option value="30" selected>৩০ দিন (১ মাস)</option>
              <option value="90">৯০ দিন (৩ মাস)</option>
              <option value="180">১৮০ দিন (৬ মাস)</option>
              <option value="365">৩৬৫ দিন (১ বছর)</option>
            </select>
            <div class="text-warning small mt-1">💡 কাস্টমার যত দিনের প্যাকেজ কিনেছে তা সিলেক্ট করুন। সময় শেষ হলে একাউন্ট অটোমেটিক লক হবে।</div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4 fw-semibold w-100 py-2 fs-6">Create Account & Grant Access (একাউন্ট তৈরি করুন)</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
