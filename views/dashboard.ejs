<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Auto Hit Master</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #0f172a; color: #f8fafc; font-family: 'Segoe UI', system-ui, sans-serif; }
    .sidebar { background: #1e293b; min-height: 100vh; border-right: 1px solid #334155; }
    .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; }
    .nav-link:hover, .nav-link.active { color: #38bdf8; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8; }
    .stat-card { background: #1e293b; border: 1px solid #334155; border-radius: 10px; }
    .table-custom { background: #1e293b; color: #f8fafc; }
    .table-custom th { background: #0f172a; color: #94a3b8; border-color: #334155; }
    .table-custom td { border-color: #334155; vertical-align: middle; }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3" style="width: 260px;">
      <div class="d-flex align-items-center gap-2 mb-4 px-2">
        <img src="/logo.png" style="width:32px; height:32px; object-fit:contain;">
        <h4 class="fw-bold text-info mb-0">Auto Hit Master</h4>
      </div>
      <div class="nav flex-column">
        <a href="/admin/dashboard" class="nav-link active"><i class="bi bi-grid-fill me-2"></i> Dashboard</a>
        <a href="/admin/users" class="nav-link"><i class="bi bi-people-fill me-2"></i> Users & Licenses</a>
        <a href="/admin/users/create" class="nav-link"><i class="bi bi-person-plus-fill me-2"></i> Add New User</a>
        <a href="/admin/logout" class="nav-link text-danger mt-4"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold">Overview Dashboard</h2>
          <p class="text-muted small">Manage client access, device locks, and subscription renewals</p>
        </div>
        <a href="/admin/users/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create User Account</a>
      </div>

      <!-- Stats Grid -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="stat-card p-3">
            <div class="text-muted small">TOTAL CLIENT USERS</div>
            <div class="fs-2 fw-bold text-white"><%= stats.total %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card p-3">
            <div class="text-muted small">ACTIVE SUBSCRIPTIONS</div>
            <div class="fs-2 fw-bold text-success"><%= stats.active %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card p-3">
            <div class="text-muted small">EXPIRED SUBSCRIPTIONS</div>
            <div class="fs-2 fw-bold text-warning"><%= stats.expired %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card p-3">
            <div class="text-muted small">SUSPENDED ACCOUNTS</div>
            <div class="fs-2 fw-bold text-danger"><%= stats.suspended %></div>
          </div>
        </div>
      </div>

      <!-- Recent Users Table -->
      <div class="stat-card p-4">
        <h5 class="fw-bold mb-3">Recently Added Client Accounts</h5>
        <div class="table-responsive">
          <table class="table table-custom mb-0">
            <thead>
              <tr>
                <th>USER ID</th>
                <th>CLIENT NAME</th>
                <th>PHONE</th>
                <th>STATUS</th>
                <th>EXPIRY DATE</th>
                <th>REGISTERED</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentUsers && recentUsers.length > 0) { %>
                <% recentUsers.forEach(u => { %>
                  <tr>
                    <td class="fw-bold text-info"><%= u.user_id %></td>
                    <td><%= u.name || 'N/A' %></td>
                    <td><%= u.phone || 'N/A' %></td>
                    <td>
                      <% if (u.status === 'active') { %>
                        <span class="badge bg-success">Active</span>
                      <% } else { %>
                        <span class="badge bg-danger">Suspended</span>
                      <% } %>
                    </td>
                    <td><%= new Date(u.expires_at).toLocaleDateString() %></td>
                    <td class="text-muted small"><%= new Date(u.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-3">No client users created yet. Click "Create User Account" to add one.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
