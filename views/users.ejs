<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users & Licenses - Auto Hit Master</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #0f172a; color: #f8fafc; font-family: 'Segoe UI', system-ui, sans-serif; }
    .sidebar { background: #1e293b; min-height: 100vh; border-right: 1px solid #334155; }
    .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; }
    .nav-link:hover, .nav-link.active { color: #38bdf8; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8; }
    .card-custom { background: #1e293b; border: 1px solid #334155; border-radius: 10px; }
    .table-custom { background: #1e293b; color: #f8fafc; }
    .table-custom th { background: #0f172a; color: #94a3b8; border-color: #334155; }
    .table-custom td { border-color: #334155; vertical-align: middle; }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3" style="width: 260px;">
      <div class="d-flex align-items-center gap-2 mb-4 px-2">
        <img src="/logo.png" style="width:32px; height:32px; object-fit:contain;">
        <h4 class="fw-bold text-info mb-0">Auto Hit Master</h4>
      </div>
      <div class="nav flex-column">
        <a href="/admin/dashboard" class="nav-link"><i class="bi bi-grid-fill me-2"></i> Dashboard</a>
        <a href="/admin/users" class="nav-link active"><i class="bi bi-people-fill me-2"></i> Users & Licenses</a>
        <a href="/admin/users/create" class="nav-link"><i class="bi bi-person-plus-fill me-2"></i> Add New User</a>
        <a href="/admin/logout" class="nav-link text-danger mt-4"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold">User Accounts & Licenses</h2>
          <p class="text-muted small">Manage client access, extend validity, record payments, and reset PC hardware locks</p>
        </div>
        <a href="/admin/users/create" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> Create New User ID</a>
      </div>

      <% if (msg) { %>
        <div class="alert alert-success py-2 alert-dismissible fade show"><%= msg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
      <% } %>

      <div class="card-custom p-4">
        <div class="table-responsive">
          <table class="table table-custom mb-0 align-middle">
            <thead>
              <tr>
                <th>USER ID</th>
                <th>NAME</th>
                <th>PAYMENT RECORD</th>
                <th>PC LOCK</th>
                <th>STATUS</th>
                <th>EXPIRY DATE</th>
                <th>REMAINING</th>
                <th>ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% if (users && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr>
                    <td class="fw-bold text-info"><%= u.user_id %></td>
                    <td><%= u.name || '-' %></td>
                    <td>
                      <% if (u.payment_amount) { %>
                        <span class="badge bg-info text-dark">৳<%= u.payment_amount %></span>
                        <small class="text-muted"><%= u.payment_note || '' %></small>
                      <% } else { %>
                        <span class="text-muted small">No record</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (u.hwid) { %>
                        <span class="badge bg-secondary"><i class="bi bi-laptop me-1"></i> Locked to PC</span>
                      <% } else { %>
                        <span class="badge bg-outline-success border text-success"><i class="bi bi-plus-circle me-1"></i> Ready for 1st PC</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (u.status === 'suspended') { %>
                        <span class="badge bg-danger">Suspended</span>
                      <% } else if (u.isExpired) { %>
                        <span class="badge bg-warning text-dark">Expired</span>
                      <% } else { %>
                        <span class="badge bg-success">Active</span>
                      <% } %>
                    </td>
                    <td><%= u.expires_at ? u.expires_at.substring(0, 10) : '-' %></td>
                    <td>
                      <% if (u.isExpired) { %>
                        <span class="text-danger fw-bold">0 Days (Expired)</span>
                      <% } else { %>
                        <span class="text-success fw-bold"><%= u.daysLeft %> Days Left</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <form action="/admin/users/<%= u.id %>/renew" method="POST" class="d-inline">
                          <select name="extend_days" onchange="this.form.submit()" class="form-select form-select-sm bg-dark text-white border-info" style="width:110px;">
                            <option value="">+ Renew</option>
                            <option value="7">+ 7 Days</option>
                            <option value="30">+ 30 Days</option>
                            <option value="90">+ 90 Days</option>
                            <option value="365">+ 1 Year</option>
                          </select>
                        </form>
                        <button class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#editModal<%= u.id %>">
                          ✏️ Edit/Pay/Date
                        </button>
                        <% if (u.hwid) { %>
                          <form action="/admin/users/<%= u.id %>/reset-pc" method="POST" class="d-inline" onsubmit="return confirm('Reset PC lock?');">
                            <button type="submit" class="btn btn-outline-warning" title="Reset PC Hardware Lock">Reset PC</button>
                          </form>
                        <% } %>
                        <form action="/admin/users/<%= u.id %>/toggle-status" method="POST" class="d-inline">
                          <button type="submit" class="btn <%= u.status === 'active' ? 'btn-outline-secondary' : 'btn-outline-success' %>">
                            <%= u.status === 'active' ? 'Suspend' : 'Activate' %>
                          </button>
                        </form>
                        <form action="/admin/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete user?');">
                          <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                      </div>

                      <!-- EDIT PAYMENT & CUSTOM EXPIRY MODAL -->
                      <div class="modal fade" id="editModal<%= u.id %>" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content bg-dark text-white border-info">
                            <div class="modal-header border-secondary">
                              <h5 class="modal-title text-info fw-bold">Edit User & Payment - <%= u.user_id %></h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/admin/users/<%= u.id %>/update-payment" method="POST">
                              <div class="modal-body text-start">
                                <div class="mb-3">
                                  <label class="text-info fw-bold small d-block mb-1">পেমেন্টের পরিমাণ (PAYMENT AMOUNT ৳)</label>
                                  <input type="text" name="payment_amount" class="form-control bg-dark text-white border-secondary" value="<%= u.payment_amount || '' %>" placeholder="যেমন: 500 বা 1500">
                                </div>
                                <div class="mb-3">
                                  <label class="text-info fw-bold small d-block mb-1">পেমেন্টের নোট / মাধ্যম (PAYMENT NOTE)</label>
                                  <input type="text" name="payment_note" class="form-control bg-dark text-white border-secondary" value="<%= u.payment_note || '' %>" placeholder="যেমন: bKash - 22 Aug">
                                </div>
                                <div class="mb-3">
                                  <label class="text-info fw-bold small d-block mb-1">কাস্টম মেয়াদের তারিখ (CUSTOM EXPIRY DATE)</label>
                                  <input type="date" name="custom_expiry_date" class="form-control bg-dark text-white border-info" value="<%= u.expires_at ? u.expires_at.substring(0, 10) : '' %>">
                                  <div class="text-warning small mt-1">💡 ক্যালেন্ডার থেকে যেকোনো মেয়াদের তারিখ সিলেক্ট করুন।</div>
                                </div>
                              </div>
                              <div class="modal-footer border-secondary">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary fw-bold">Save Changes</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>

                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">No client user accounts created yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
